# Copy this template to .env only if that file does not already exist.
# Fill in credentials in .env yourself. Never commit it or put keys in VITE_ variables.
# Non-secret application options live in settings.toml.
# This template selects offline settings for credential-free Docker checks.
# Omit this selector from your private .env to use settings.toml.
APP_SETTINGS_FILE=./settings.example.toml

# Nessie v2: backend reads and explicit generator --apply requests.
NESSIE_API_KEY=
# Required when data_source = "nessie"; this is not a Nessie key.
APP_API_TOKEN=

# Photon 2.0 (Beta), not the legacy Spectrum API.
PHOTON_API_KEY=
# The webhook destination signing secret (whsec_...), separate from the API key.
PHOTON_WEBHOOK_SECRET=

# LangChain backends. Fill only the provider(s) you intend to use.
# Select llm_provider and enable llm_enabled in your public settings file.
# APP_API_TOKEN is also required when AI is enabled, including fixture mode.
GEMINI_API_KEY=
NVIDIA_API_KEY=
