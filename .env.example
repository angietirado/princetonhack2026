# Run commands from the repository root. Secrets stay on the backend.
DATA_SOURCE=fixture
FIXTURE_PATH=.data/demo.json
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=
# Required when DATA_SOURCE=nessie. This is a temporary single-user demo gate.
APP_API_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Photon 2.0 (Beta), not the legacy Spectrum API.
PHOTON_API_BASE_URL=https://api.photon.codes/v1
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
PHOTON_WEBHOOK_SECRET=
# One explicitly enrolled Photon human User ID for this single-customer demo.
PHOTON_ALLOWED_SENDER_ID=
PHOTON_INBOX_PATH=.data/photon-inbox.sqlite3
