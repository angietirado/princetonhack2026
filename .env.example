# Optional Docker Compose overrides. The defaults are local development only.
CAMPUS_WEB_PORT=8080
CAMPUS_API_PORT=8001
CAMPUS_MONGO_PORT=27017
CAMPUS_STUDENT_CHECK_LIMIT_PER_HOUR=30
# Set true locally to enable reusable dev_student1/dev_student2 test profiles.
DEVMODE=false

# Direct Python development (export these variables in your shell):
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DATABASE=campus_exchange
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# COOKIE_SECURE=false
# STUDENT_CHECK_LIMIT_PER_HOUR=30

